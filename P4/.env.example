# Secreto compartido entre auth-service y api-gateway para firmar
# y verificar los JWT. Ya generado aleatoriamente (96 chars hex).
# Si quieres generar otro:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Clave AES-256-GCM usada por auth-service para cifrar el email
# de los usuarios en la base de datos. Debe ser hex de EXACTAMENTE
# 64 caracteres (32 bytes = 256 bits). Genérala tú con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# o si no tienes Node a mano:
#   openssl rand -hex 32
AES_KEY=
