{"nodes": [{"id": "p10_docs_slo", "label": "SLO de PrintHub (slo.md)", "file_type": "document", "source_file": "P10/docs/slo.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "p10_docs_slo_slo_crear_pedidos", "label": "SLO 1: Crear pedidos funciona (99 % sin 5xx, 28 d)", "file_type": "concept", "source_file": "P10/docs/slo.md", "source_location": "SLO 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Crear el pedido genera ingreso. 99.9 % no es alcanzable con MySQL/RabbitMQ en una replica (RTO medido 23 min); 99 % deja ~6.7 h y 95 % seria inaceptable para una tienda. Solo 5xx consumen presupuesto."}, {"id": "p10_docs_slo_slo_latencia", "label": "SLO 2: La tienda responde rapido (99 % en <= 0.5 s, 28 d)", "file_type": "concept", "source_file": "P10/docs/slo.md", "source_location": "SLO 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "0.5 s es el umbral de fluidez y el mismo del analisis del canary; se midio p99 69 ms y 99.92 %, por lo que 95 % nunca estaria en riesgo. Se mide porcentaje y no p95 porque un percentil no se suma entre ventanas."}, {"id": "p10_docs_slo_ventana_28_dias", "label": "Ventana de 28 dias moviles", "file_type": "rationale", "source_file": "P10/docs/slo.md", "source_location": "Ventana de 28 dias", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cuatro semanas exactas: el SLI no cambia por el calendario. Nominal: Prometheus retiene 3 dias."}, {"id": "p10_docs_slo_prometheusrule_slo_printhub", "label": "PrometheusRule slo-printhub (reglas de registro)", "file_type": "concept", "source_file": "P10/docs/slo.md", "source_location": "Reglas de registro", "source_url": "https://github.com/GeoNufio1404/software-avanzado-gitops/blob/main/observability/slo-printhub.yaml", "captured_at": null, "author": null, "contributor": null}, {"id": "p10_docs_slo_burn_rate_multiventana", "label": "Alertas burn rate multiventana (libro SRE de Google)", "file_type": "rationale", "source_file": "P10/docs/slo.md", "source_location": "Alertas", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ventana larga evita ruido por picos; ventana corta deja de sonar al corregirse. Rapida 14.4x en 1h+5m (page), lenta 6x en 6h+30m (ticket). Deteccion esperada ~8.6 min con 100 % de fallo."}, {"id": "p10_docs_slo_alertas_eliminadas", "label": "Alertas eliminadas (defaultRules.create: false)", "file_type": "rationale", "source_file": "P10/docs/slo.md", "source_location": "Alertas", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Las ~150 reglas por defecto de kube-prometheus-stack son umbrales instantaneos de infraestructura que no dicen si el usuario esta afectado; se ven en el tablero, no despiertan a nadie."}, {"id": "p10_docs_slo_error_budget", "label": "Presupuesto de error consumido", "file_type": "concept", "source_file": "P10/docs/slo.md", "source_location": "Reglas de registro", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "p10_docs_slo", "target": "p10_docs_slo_slo_crear_pedidos", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "P10/docs/slo.md", "source_location": null, "weight": 1.0}, {"source": "p10_docs_slo", "target": "p10_docs_slo_slo_latencia", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "P10/docs/slo.md", "source_location": null, "weight": 1.0}, {"source": "p10_docs_slo_ventana_28_dias", "target": "p10_docs_slo_slo_crear_pedidos", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "P10/docs/slo.md", "source_location": "Ventana de 28 dias", "weight": 1.0}, {"source": "p10_docs_slo_ventana_28_dias", "target": "p10_docs_slo_slo_latencia", "relation": "ratio