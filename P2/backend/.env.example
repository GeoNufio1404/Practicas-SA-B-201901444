# --- Servidor ---
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=practica2_auth

# --- JWT ---
# Genera un secreto largo y aleatorio, ej: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=changeme_super_secreto
# Tiempo de vida del token, en segundos (ej. 900 = 15 min)
JWT_EXPIRATION_SECONDS=900
# Ventana de gracia tras expirar el token durante la cual aún se puede renovar (segundos)
JWT_RENEWAL_GRACE_SECONDS=300

# --- Encriptación AES (para nombre y correo) ---
# Debe ser una clave de 32 bytes para AES-256. Genera con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AES_SECRET_KEY=changeme_32_bytes_en_hex

# --- Microservicio de autorización ---
AUTH_SERVICE_URL=http://localhost:5000
AUTH_SERVICE_RETRY_MAX_ATTEMPTS=4
AUTH_SERVICE_RETRY_BACKOFF_MS=300
# Tiempo máximo de espera por intento antes de considerarlo timeout (ms)
AUTH_SERVICE_TIMEOUT_MS=2000
